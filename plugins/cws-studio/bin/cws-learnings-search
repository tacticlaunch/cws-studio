#!/usr/bin/env bash
# Search the per-project learnings file. Defaults to last N entries.
# Usage:
#   cws-learnings-search                       # last 5
#   cws-learnings-search --limit 10
#   cws-learnings-search --stage idea          # filter by stage tag
#   cws-learnings-search --grep "keyword"
set -e
eval "$($(dirname "$0")/cws-slug)"
F="$CWS_PROJECT_DIR/learnings.jsonl"
[ ! -f "$F" ] && exit 0

LIMIT=5
STAGE=""
GREP=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --limit) LIMIT="$2"; shift 2;;
    --stage) STAGE="$2"; shift 2;;
    --grep)  GREP="$2"; shift 2;;
    *) shift;;
  esac
done

OUT="$F"
TMP=""
if [ -n "$STAGE" ]; then
  TMP=$(mktemp)
  /usr/bin/python3 -c "
import json, sys
stage = sys.argv[1]
for line in open(sys.argv[2]):
    try:
        d = json.loads(line)
        if d.get('stage') == stage: print(line, end='')
    except Exception: pass
" "$STAGE" "$F" > "$TMP" 2>/dev/null || true
  OUT="$TMP"
fi
if [ -n "$GREP" ]; then
  TMP2=$(mktemp)
  /usr/bin/grep -i -- "$GREP" "$OUT" > "$TMP2" 2>/dev/null || true
  OUT="$TMP2"
fi
tail -n "$LIMIT" "$OUT" 2>/dev/null
[ -n "$TMP" ] && rm -f "$TMP" || true
[ -n "${TMP2:-}" ] && rm -f "$TMP2" || true
exit 0
